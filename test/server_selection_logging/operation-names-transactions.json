      ]
    },
    {
      "description": "client bulkWrite reports bulkWrite",
      "runOnRequirements": [
        {
          "minServerVersion": "8.0",
          "topologies": [
            "replicaset"
          ],
          "serverless": "forbid"
        }
      ],
      "operations": [
        {
          "name": "clientBulkWrite",
          "object": "client",
          "arguments": {
            "models": [
              {
                "insertOne": {
                  "namespace": "logging-tests.server-selection",
                  "document": {
                    "_id": 5,
                    "x": 5
                  }
                }
              }
            ]
          }
        }
      ],
      "expectLogMessages": [
        {
          "client": "client",
          "messages": [
