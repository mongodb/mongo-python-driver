{
  "description": "write-concern-errors-aggregate",
  "schemaVersion": "1.0",
  "createEntities": [
    {
      "client": {
        "id": "client0",
        "useMultipleMongoses": false
      }
    },
    {
      "database": {
        "id": "database0",
        "client": "client0",
        "databaseName": "write-concern-errors-tests"
      }
    },
    {
      "collection": {
        "id": "collection0",
        "database": "database0",
        "collectionName": "coll"
      }
    }
  ],
  "initialData": [
    {
      "collectionName": "coll",
      "databaseName": "write-concern-errors-tests",
      "documents": []
    }
  ],
  "tests": [
    {
      "description": "aggregate with $out reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "aggregate"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "aggregate",
          "object": "collection0",
          "arguments": {
            "pipeline": [
              {
                "$match": {
                  "_id": {
                    "$gt": 1
                  }
                }
              },
              {
                "$out": "aggregate_out"
              }
            ]
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "aggregate with $merge reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "aggregate"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "aggregate",
          "object": "collection0",
          "arguments": {
            "pipeline": [
              {
                "$match": {
                  "_id": {
                    "$gt": 1
                  }
                }
              },
              {
                "$merge": {
                  "into": "aggregate_merge"
                }
              }
            ]
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    }
  ]
}
