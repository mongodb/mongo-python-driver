{
  "description": "write-concern-errors-gridfs",
  "schemaVersion": "1.0",
  "createEntities": [
    {
      "client": {
        "id": "client0",
        "useMultipleMongoses": false
      }
    },
    {
      "database": {
        "id": "database0",
        "client": "client0",
        "databaseName": "write-concern-errors-tests"
      }
    },
    {
      "bucket": {
        "id": "bucket0",
        "database": "database0"
      }
    }
  ],
  "initialData": [
    {
      "databaseName": "write-concern-errors-tests",
      "collectionName": "fs.files",
      "documents": [
        {
          "_id": {
            "$oid": "000000000000000000000001"
          },
          "length": 0,
          "chunkSize": 4,
          "uploadDate": {
            "$date": "1970-01-01T00:00:00.000Z"
          },
          "filename": "filename"
        }
      ]
    },
    {
      "databaseName": "write-concern-errors-tests",
      "collectionName": "fs.chunks",
      "documents": []
    }
  ],
  "tests": [
    {
      "description": "upload reports a writeConcernError from a chunk insert",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "insert"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "upload",
          "object": "bucket0",
          "arguments": {
            "filename": "filename",
            "source": {
              "$$hexBytes": "1122334455"
            }
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "upload reports a writeConcernError from the files document insert",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "skip": 1
              },
              "data": {
                "failCommands": [
                  "insert"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "upload",
          "object": "bucket0",
          "arguments": {
            "filename": "filename",
            "source": {
              "$$hexBytes": "1122334455"
            }
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "delete reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "delete"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "delete",
          "object": "bucket0",
          "arguments": {
            "id": {
              "$oid": "000000000000000000000001"
            }
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "deleteByName reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "delete"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "deleteByName",
          "object": "bucket0",
          "arguments": {
            "filename": "filename"
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "file rename reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "update"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "rename",
          "object": "bucket0",
          "arguments": {
            "id": {
              "$oid": "000000000000000000000001"
            },
            "newFilename": "newfilename"
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    },
    {
      "description": "renameByName reports a writeConcernError",
      "operations": [
        {
          "name": "failPoint",
          "object": "testRunner",
          "arguments": {
            "client": "client0",
            "failPoint": {
              "configureFailPoint": "failCommand",
              "mode": {
                "times": 1
              },
              "data": {
                "failCommands": [
                  "update"
                ],
                "writeConcernError": {
                  "code": 79,
                  "codeName": "UnknownReplWriteConcern"
                }
              }
            }
          }
        },
        {
          "name": "renameByName",
          "object": "bucket0",
          "arguments": {
            "filename": "filename",
            "newFilename": "newfilename"
          },
          "expectError": {
            "errorCode": 79
          }
        }
      ]
    }
  ]
}
